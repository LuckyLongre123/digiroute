// use prisma-8

model User {
  id           String       @id @default(uuid())
  email        String?      @unique
  phone        String?      @unique
  name         String?
  passwordHash String?
  addresses    Address[]
  consentLogs  ConsentLog[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Address {
  id              String    @id @default(uuid())
  slug            String    @unique
  digipin         String
  baseLat         Float
  baseLng         Float
  entranceLat     Float
  entranceLng     Float
  floor           String?
  flat            String?
  landmark        String?
  label           String?
  routingNotes    String?
  doorwayPhotoUrl String?
  passcode        String?
  isEphemeral     Boolean   @default(false)
  expiresAt       TimestamptzString?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model ConsentLog {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  userEmail     String
  userName      String?
  consentType   String
  action        String
  policyVersion String
  source        String
  userAgent     String?
  createdAt     TimestamptzString @default(now())
}
